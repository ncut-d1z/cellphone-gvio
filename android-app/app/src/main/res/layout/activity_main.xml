<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#20232A">

    <RadioGroup
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#2C3038">

        <RadioButton
            android:id="@+id/tabCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:button="@android:color/transparent"
            android:gravity="center"
            android:textColor="#E8EAF0"
            android:text="相机" />

        <RadioButton
            android:id="@+id/tabImu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@android:color/transparent"
            android:gravity="center"
            android:textColor="#E8EAF0"
            android:text="IMU" />

        <RadioButton
            android:id="@+id/tabMag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@android:color/transparent"
            android:gravity="center"
            android:textColor="#E8EAF0"
            android:text="磁强计" />

        <RadioButton
            android:id="@+id/tabGps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@android:color/transparent"
            android:gravity="center"
            android:textColor="#E8EAF0"
            android:text="GPS" />
    </RadioGroup>

    <ViewFlipper
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 相机页: 双预览 + 控制面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextureView
                        android:id="@+id/camViewBack"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/camInfoBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:padding="6dp"
                        android:textSize="12sp"
                        android:textColor="#FFD54F"
                        android:background="#88000000"
                        android:text="后置相机未启动" />
                </FrameLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#3A3F47" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextureView
                        android:id="@+id/camViewFront"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/camInfoFront"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:padding="6dp"
                        android:textSize="12sp"
                        android:textColor="#FFD54F"
                        android:background="#88000000"
                        android:text="前置相机未启动" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="#E620232A">

                <RadioGroup
                    android:id="@+id/ctlTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/targetBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="控制: 后置"
                        android:textColor="#E8EAF0" />

                    <RadioButton
                        android:id="@+id/targetFront"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="控制: 前置"
                        android:textColor="#E8EAF0" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:text="变焦"
                        android:textSize="13sp"
                        android:textColor="#E8EAF0" />

                    <SeekBar
                        android:id="@+id/zoomSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/zoomLabel"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textSize="13sp"
                        android:textColor="#90CAF9"
                        android:text="1.0x" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/focusCb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="手动对焦"
                        android:textSize="13sp"
                        android:textColor="#E8EAF0" />

                    <SeekBar
                        android:id="@+id/focusSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/focusLabel"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textSize="13sp"
                        android:textColor="#90CAF9"
                        android:text="∞" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:text="曝光"
                        android:textSize="13sp"
                        android:textColor="#E8EAF0" />

                    <SeekBar
                        android:id="@+id/evSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/evLabel"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textSize="13sp"
                        android:textColor="#90CAF9"
                        android:text="+0" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- IMU 页 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFD54F"
                    android:text="加速度计 (m/s²)" />
                <TextView
                    android:id="@+id/accelX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#E8EAF0" />
                <TextView
                    android:id="@+id/accelY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#E8EAF0" />
                <TextView
                    android:id="@+id/accelZ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#E8EAF0" />
                <TextView
                    android:id="@+id/accelHz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#90CAF9" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#3A3F47" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFD54F"
                    android:text="陀螺仪 (rad/s)" />
                <TextView
                    android:id="@+id/gyroX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#E8EAF0" />
                <TextView
                    android:id="@+id/gyroY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#E8EAF0" />
                <TextView
                    android:id="@+id/gyroZ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#E8EAF0" />
                <TextView
                    android:id="@+id/gyroHz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#90CAF9" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#3A3F47" />

                <TextView
                    android:id="@+id/imuEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#9FA8B0" />
            </LinearLayout>
        </ScrollView>

        <!-- 磁强计页 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/magInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#E8EAF0" />
            </LinearLayout>
        </ScrollView>

        <!-- GPS 页 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/gpsInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#E8EAF0" />
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>
</LinearLayout>
