# Private keys, signing stores and locally generated development TLS material.
# gitignore is NOT a security boundary: CI also scans the Git index contents.
*.[kK][eE][yY]
*.[pP][eE][mM]
*.[pP]12
*.[pP][fF][xX]
*.pk8
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
/backend/certs/*
!/backend/certs/README.md
/android-app/app/src/main/assets/certs/*
.tls-*/
